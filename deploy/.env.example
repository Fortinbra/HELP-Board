HELPBOARD_IMAGE=ghcr.io/fortinbra/help-board:latest
HELPBOARD_BIND_IP=REPLACE_WITH_PITONY_LAN_IP
HELPBOARD_APP_PORT=2026
HELPBOARD_PROXY_IP=REPLACE_WITH_NPM_SOURCE_IP
# Obtain an OAuth 2.0 Web application client from the organization's Google Cloud project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The Workspace hosted domain allowed to sign in (for example, example.org).
GOOGLE_WORKSPACE_DOMAIN=
# Optional comma-separated Workspace email addresses assigned the Admin role.
GOOGLE_ADMIN_EMAILS=
# Keep using a dedicated empty preview database until reporting is ready.
DB_CONNECTION_STRING='Host=REPLACE_WITH_PIDB_HOST;Port=5432;Database=REPLACE_WITH_PREVIEW_DATABASE;Username=REPLACE_WITH_APP_USER;Password=REPLACE_ON_SERVER;Pooling=true;Minimum Pool Size=0;Maximum Pool Size=10;Timeout=15;Command Timeout=30;Connection Lifetime=300'
