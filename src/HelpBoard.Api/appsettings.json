{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FeatureManagement": {
    "DatabaseMigrationsApplyAtStartup": false
  },
  "ReverseProxy": {
    "UseForwardedHeaders": false
  },
  "HttpsRedirection": {
    "Enabled": true
  }
}
