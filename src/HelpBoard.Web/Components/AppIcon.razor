<svg
    class="@CssClass"
    width="@Size"
    height="@Size"
    viewBox="0 0 24 24"
    stroke-linecap="round"
    stroke-linejoin="round"
    focusable="false"
    role="@Role"
    aria-hidden="@AriaHidden"
    aria-label="@AriaLabel">
    @if (!IsDecorative)
    {
        <title>@Title</title>
    }

    @switch (NormalizedName)
    {
        case "activity":
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
            break;
        case "alert-circle":
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
            break;
        case "arrow-up-right":
            <path d="M7 17 17 7" />
            <path d="M7 7h10v10" />
            break;
        case "check-circle-2":
            <path d="M9 12l2 2 4-4" />
            <circle cx="12" cy="12" r="10" />
            break;
        case "clock-3":
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16.5 12" />
            break;
        case "home":
            <path d="M3 10.5 12 3l9 7.5" />
            <path d="M5 9.5V21h14V9.5" />
            <path d="M9 21v-6h6v6" />
            break;
        case "inbox":
            <path d="M4 4h16v10l-3 4H7l-3-4V4Z" />
            <path d="M4 14h4l2 3h4l2-3h4" />
            break;
        case "menu":
            <line x1="4" y1="7" x2="20" y2="7" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="17" x2="20" y2="17" />
            break;
        case "panel-left":
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <path d="M9 4v16" />
            break;
        case "plus-square":
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <path d="M12 8v8" />
            <path d="M8 12h8" />
            break;
        case "ticket":
            <path d="M3 9a3 3 0 1 0 0 6v3h18v-3a3 3 0 1 0 0-6V6H3Z" />
            <path d="M13 6v12" stroke-dasharray="3 2" />
            break;
        default:
            <circle cx="12" cy="12" r="9" />
            <path d="M12 8v8" />
            <path d="M8 12h8" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public int Size { get; set; } = 20;

    private bool IsDecorative => string.IsNullOrWhiteSpace(Title);

    private string NormalizedName => Name.Trim().ToLowerInvariant();

    private string CssClass => string.IsNullOrWhiteSpace(Class)
        ? "hb-icon"
        : $"hb-icon {Class}";

    private string? AriaHidden => IsDecorative ? "true" : null;

    private string? AriaLabel => IsDecorative ? null : Title;

    private string Role => IsDecorative ? "presentation" : "img";
}