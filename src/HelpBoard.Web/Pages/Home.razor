@page "/"

<PageTitle>Dashboard</PageTitle>

<section class="hb-stack-lg">
    <header class="hb-page-header">
        <div class="hb-stack-sm">
            <p class="hb-eyebrow">Operations overview</p>
            <h1>Dashboard summary</h1>
            <p class="hb-page-copy">
                Review top-level operational signals and use drill-down actions to move directly
                to detailed ticket, board, and strategic plan surfaces.
            </p>
        </div>

        <a class="hb-button hb-button--secondary" href="https://learn.microsoft.com/aspnet/core/blazor/components/" target="_blank" rel="noreferrer" aria-label="Component guidance (opens in a new tab)">
            <AppIcon Name="arrow-up-right" />
            <span>Component guidance (opens in a new tab)</span>
        </a>
    </header>

    <DashboardSummarySection
        Title="Workstream summary"
        Description="Above-the-fold cards are prioritized for quick scanning and direct drill-down navigation."
        LastUpdatedText="@LastUpdatedText"
        IsLoading="@IsLoading"
        ErrorMessage="@ErrorMessage"
        Cards="@SummaryCards"
        OnRetry="ReloadSummaryAsync" />
</section>
