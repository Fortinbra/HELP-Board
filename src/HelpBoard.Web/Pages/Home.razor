@page "/"
@layout LandingLayout

<PageTitle>Welcome | HELP-Board</PageTitle>

<section class="landing-content" aria-labelledby="landing-title">
    <p class="landing-eyebrow">For authorized HELP members</p>
    <h1 id="landing-title">Welcome to HELP-Board</h1>
    <p class="landing-copy">Sign in with your HELP Google Workspace account to continue.</p>
    @if (_isLoading)
    {
        <p class="landing-status" role="status">Checking sign-in availability</p>
    }
    else if (_errorMessage is not null)
    {
        <p class="landing-status" role="alert">@_errorMessage</p>
        <a class="baseline-login__action"
           href="/auth/sign-in?returnUrl=%2Fdashboard"
           @onclick="StartSignIn"
           @onclick:preventDefault="true">Try signing in</a>
    }
    else if (_status is { IsAuthenticated: true })
    {
        <a class="landing-action"
           href="/dashboard"
           @onclick="OpenDashboard"
           @onclick:preventDefault="true">Continue to the dashboard</a>
    }
    else if (_status is { GoogleSignInEnabled: true })
    {
        <a class="landing-action"
           href="/auth/sign-in?returnUrl=%2Fdashboard"
           @onclick="StartSignIn"
           @onclick:preventDefault="true">Sign in with Google Workspace</a>
    }
    else
    {
        <p class="landing-status" role="status">Sign-in is temporarily unavailable. Please check back later.</p>
    }
</section>
