<aside class="app-sidebar">
    <div class="app-sidebar__top">
        <a class="app-brand" href="">
            <span class="app-brand__mark" aria-hidden="true">
                <AppIcon Name="panel-left" />
            </span>
            <span>
                <span class="app-brand__name">HELP-Board</span>
                <span class="app-brand__meta">Service operations workspace</span>
            </span>
        </a>

        <button
            type="button"
            class="nav-toggle"
            aria-controls="primary-navigation"
            aria-expanded="@(!collapseNavMenu)"
            @onclick="ToggleNavMenu">
            <AppIcon Name="menu" />
            <span>Menu</span>
        </button>
    </div>

    <div id="primary-navigation" class="app-sidebar__panel @NavMenuCssClass">
        <nav class="app-nav" aria-label="Primary navigation">
            <p class="app-nav__label">Workspace</p>

            <NavLink class="app-nav__link" href="" Match="NavLinkMatch.All" @onclick="CloseNavMenu">
                <AppIcon Name="home" />
                <span>Dashboard</span>
            </NavLink>

            <NavLink class="app-nav__link" href="tickets" @onclick="CloseNavMenu">
                <AppIcon Name="ticket" />
                <span>Work items</span>
            </NavLink>

            <NavLink class="app-nav__link" href="tickets/active" @onclick="CloseNavMenu">
                <AppIcon Name="activity" />
                <span>Active work</span>
            </NavLink>

            <NavLink class="app-nav__link" href="strategic-plan" @onclick="CloseNavMenu">
                <AppIcon Name="panel-left" />
                <span>Strategic plan</span>
            </NavLink>

            <NavLink class="app-nav__link" href="boards" @onclick="CloseNavMenu">
                <AppIcon Name="menu" />
                <span>Project boards</span>
            </NavLink>

            <NavLink class="app-nav__link" href="counter" @onclick="CloseNavMenu">
                <AppIcon Name="plus-square" />
                <span>Counter</span>
            </NavLink>
        </nav>

        <div class="app-sidebar__footer">
            <span class="hb-badge hb-badge--accent">Default theme</span>
            <p>Teal and purple tokens now drive the shared shell.</p>
        </div>
    </div>
</aside>
